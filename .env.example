# MayaCardio Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your live .env with real credentials.

# Edge Device Configuration
DEVICE_ID=bedside-pi4-001
STORAGE_DB_PATH=pipeline.db
MOCK_TCP_HOST=127.0.0.1
MOCK_TCP_PORT=7100

# Cloudflare Cloud Service Configuration
CLOUD_BASE_URL=https://mayacardio.example.workers.dev
CLOUD_AUTH_TOKEN=change-this-to-a-secure-random-token
CLOUD_INGEST_TIMEOUT_MS=5000
CLOUD_HEALTH_PROBE_INTERVAL_MS=1000

# Cloudflare Worker Deployment Secrets (Wrangler)
# Set via: wrangler secret put AUTH_TOKEN
AUTH_TOKEN=change-this-to-a-secure-random-token
